#!/bin/sh
. /usr/share/libubox/jshn.sh

reply() {
	json_init
	json_add_boolean ok "$1"
	json_add_string message "$2"
	json_dump
}

dependency_list() {
	missing=''
	command -v curl >/dev/null 2>&1 || missing='curl'
	[ -s /etc/ssl/certs/ca-certificates.crt ] || missing="${missing:+$missing }ca-bundle"
}

case "$1" in
list)
	echo '{"status":{},"logs":{},"traffic":{},"dependencies":{},"control":{"action":""},"test":{},"sites":{"site":""},"install_dependencies":{},"check_update":{},"install_update":{},"update_status":{}}'
	;;
call)
	case "$2" in
	status)
		running=0
		ubus call service list '{"name":"zoordns"}' | jsonfilter -e '@.zoordns.instances.*.running' | grep -q true && running=1
		dependency_list
		json_init
		json_add_boolean running "$running"
		json_add_string version "0.1.0"
		json_add_string architecture "$(uname -m)"
		json_add_string manager "$(command -v apk >/dev/null 2>&1 && echo apk || echo opkg)"
		json_add_string missing "$missing"
		board=$(ubus call system board)
		json_add_string model "$(echo "$board" | jsonfilter -e '@.model')"
		json_add_string os "$(echo "$board" | jsonfilter -e '@.release.description')"
		json_add_int uptime "$(cut -d. -f1 /proc/uptime)"
		json_add_boolean installing "$([ -d /tmp/zoordns-deps.lock ] && echo 1 || echo 0)"
		json_add_string install_log "$(tail -4 /tmp/zoordns-deps.log 2>/dev/null)"
		json_dump
		;;
	logs)
		text=$(logread -e zoordns | tail -70)
		json_init; json_add_string text "$text"; json_dump
		;;
	traffic)
		if [ -s /var/run/zoordns/traffic.json ]; then cat /var/run/zoordns/traffic.json
		elif [ -s /etc/zoordns/traffic.json ]; then cat /etc/zoordns/traffic.json
		else echo '{"today":{"up":0,"down":0},"week":{"up":0,"down":0},"month":{"up":0,"down":0}}'; fi
		;;
	dependencies)
		dependency_list
		json_init; json_add_string missing "$missing"; json_dump
		;;
	control)
		read -r input
		json_load "$input" || { reply 0 'Invalid request'; exit 0; }
		json_get_var action action
		case "$action" in
		start|restart)
			zone=$(uci -q get zoordns.main.zone)
			key=$(uci -q get zoordns.main.pubkey)
			[ -n "$zone" ] && [ -n "$key" ] || { reply 0 'Save the server zone and public key first.'; exit 0; }
			uci set zoordns.main.enabled=1; uci commit zoordns
			/etc/init.d/zoordns enable
			/etc/init.d/zoordns restart >/dev/null 2>&1
			code=$?; [ "$code" = 0 ] && reply 1 'Service started.' || reply 0 'Service could not start. Check logs.'
			;;
		stop)
			uci set zoordns.main.enabled=0; uci commit zoordns
			/etc/init.d/zoordns stop >/dev/null 2>&1
			reply 1 'Service stopped.'
			;;
		*) reply 0 'Unsupported action' ;;
		esac
		;;
	test)
		dependency_list
		[ -z "$missing" ] || { reply 0 "Missing dependencies: $missing"; exit 0; }
		listen=$(uci -q get zoordns.main.listen)
		[ -n "$listen" ] || listen=127.0.0.1:1088
		case "$listen" in 0.0.0.0:*) listen="127.0.0.1:${listen##*:}" ;; esac
		result=$(curl --fail --silent --show-error --socks5-hostname "$listen" --connect-timeout 8 --max-time 12 https://www.cloudflare.com/cdn-cgi/trace 2>&1)
		code=$?
		if [ "$code" = 0 ]; then
			ip=$(echo "$result" | sed -n 's/^ip=//p' | head -1)
			[ -n "$ip" ] && reply 1 "HTTPS tunnel verified. Exit IP: $ip" || reply 0 'Test returned an unexpected response.'
		else reply 0 "$result"; fi
		;;
	sites)
		read -r input
		json_load "$input" || { reply 0 'Invalid request'; exit 0; }
		json_get_var site site
		case "$site" in reddit|instagram|x|all|'') /usr/libexec/zoordns/probe-sites "${site:-all}" ;; *) reply 0 'Unknown site' ;; esac
		;;
	install_dependencies)
		dependency_list
		[ -n "$missing" ] || { reply 1 'All dependencies are installed.'; exit 0; }
		if ! mkdir /tmp/zoordns-deps.lock 2>/dev/null; then reply 0 'Dependency installation is already running.'; exit 0; fi
		/usr/libexec/zoordns/install-deps > /tmp/zoordns-deps.log 2>&1 < /dev/null &
		reply 1 'Dependency installation started.'
		;;
	check_update|install_update|update_status)
		case "$2" in check_update) /usr/libexec/zoordns/update check ;; update_status) /usr/libexec/zoordns/update status ;; install_update) /usr/libexec/zoordns/update start ;; esac
		;;
	*) reply 0 'Unknown method' ;;
	esac
	;;
esac
