#!/bin/sh
. /usr/share/libubox/jshn.sh
umask 077
repo='https://github.com/dreamboxone/zoordns/releases/latest/download'
state=/tmp/zoordns-update
mkdir -p "$state"
reply() { json_init; json_add_boolean ok "$1"; json_add_string message "$2"; json_dump; }
platform() {
	. /etc/openwrt_release
	arch=$DISTRIB_ARCH
	if command -v apk >/dev/null 2>&1; then format=apk; else format=ipk; fi
}
component() {
	json_load "$(cat "$state/manifest.json")" || return 1
	json_select components && json_select "$1" || return 1
	json_get_var latest version
	json_select assets && json_select "$format" || return 1
	if [ "$1" = luci-app-zoordns ]; then json_select all || return 1; else json_select "$arch" || return 1; fi
	json_get_var filename name; json_get_var checksum sha256
	case "$filename" in ''|*[!a-zA-Z0-9._+-]*) return 1 ;; esac
	case "$checksum" in ''|*[!a-fA-F0-9]*) return 1 ;; esac
	[ "${#checksum}" = 64 ] && [ -n "$latest" ]
}
installed() {
	case "$1" in zoordns) cat /usr/share/zoordns/core.version 2>/dev/null || echo 0.1.0-r1 ;; *) cat /usr/share/zoordns/luci.version 2>/dev/null || echo 0.1.0-r1 ;; esac
}
newer() {
	if [ "$format" = apk ]; then apk version -t "$1" "$2" | grep -q '^<$'
	else opkg compare-versions "$1" '<' "$2"; fi
}
fetch_manifest() {
	command -v curl >/dev/null 2>&1 || return 1
	curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --connect-timeout 6 --max-time 12 --max-filesize 1048576 "$repo/manifest.json" -o "$state/manifest.tmp" || return 1
	json_load "$(cat "$state/manifest.tmp")" || return 1
	json_get_var schema schema
	[ "$schema" = 1 ] || return 1
	mv "$state/manifest.tmp" "$state/manifest.json"
}
status() {
	platform
	json_init
	json_add_boolean installing "$([ -d "$state/lock" ] && echo 1 || echo 0)"
	json_add_string log "$(tail -8 "$state/install.log" 2>/dev/null)"
	json_add_string architecture "$arch"
	json_add_string format "$format"
	json_add_array components
	for name in zoordns luci-app-zoordns; do
		current=$(installed "$name")
		available=0; latest=''; filename=''
		if [ -s "$state/manifest.json" ]; then
			# jshn stores its current document in shell variables. Isolate parsing.
			info=$(component "$name" && echo "$latest $filename")
			read -r latest filename <<EOF
$info
EOF
			[ -n "$latest" ] && newer "$current" "$latest" && available=1
		fi
		json_add_object ''; json_add_string name "$name"; json_add_string current "$current"; json_add_string latest "$latest"; json_add_boolean available "$available"; json_close_object
	done
	json_close_array; json_dump
}
case "$1" in
check)
	if fetch_manifest; then status; else reply 0 'No usable release manifest was found. Check dependencies, connectivity and published GitHub releases.'; fi
	;;
status) status ;;
start)
	[ -s "$state/manifest.json" ] || { reply 0 'Check for updates first.'; exit 0; }
	mkdir "$state/lock" 2>/dev/null || { reply 0 'An update is already running.'; exit 0; }
	cp /usr/libexec/zoordns/update "$state/run.sh"
	sh "$state/run.sh" install > "$state/install.log" 2>&1 < /dev/null &
	reply 1 'Update started. Only changed components will be downloaded.'
	;;
install)
	trap 'rmdir "$state/lock" 2>/dev/null' EXIT INT TERM
	platform
	set --
	for name in zoordns luci-app-zoordns; do
		current=$(installed "$name")
		component "$name" || { echo "No compatible asset: $name ($arch, $format)"; exit 1; }
		newer "$current" "$latest" || { echo "Unchanged: $name"; continue; }
		echo "Downloading: $name $latest"
		curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --connect-timeout 10 --max-time 240 --max-filesize 67108864 "$repo/$filename" -o "$state/$filename" || exit 1
		printf '%s  %s\n' "$checksum" "$state/$filename" | sha256sum -c - || exit 1
		set -- "$@" "$state/$filename"
	done
	[ "$#" -gt 0 ] || { echo 'Already up to date.'; exit 0; }
	if [ "$format" = apk ]; then apk add --allow-untrusted "$@"; else opkg install "$@"; fi
	result=$?
	if [ "$result" = 0 ]; then
		[ "$(uci -q get zoordns.main.enabled)" = 1 ] && /etc/init.d/zoordns restart
		echo 'Update completed.'
	else echo 'Update failed. Existing configuration has been retained.'; fi
	exit "$result"
	;;
*) reply 0 'Unknown update action' ;;
esac
