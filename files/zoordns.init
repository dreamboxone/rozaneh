#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled zone pubkey resolvers listen discover country tcp
	config_load zoordns
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get zone main zone
	config_get pubkey main pubkey
	config_get resolvers main resolvers
	config_get listen main listen '127.0.0.1:1088'
	config_get_bool discover main discover 0
	config_get country main country 'IR'
	config_get tcp main tcp 'auto'
	[ -n "$zone" ] && [ -n "$pubkey" ] || { logger -t zoordns 'Missing zone or public key'; return 1; }
	mkdir -p /var/run/zoordns /etc/zoordns
	chown zoordns:zoordns /var/run/zoordns /etc/zoordns
	chmod 750 /var/run/zoordns /etc/zoordns
	procd_open_instance
	procd_set_param user zoordns
	procd_set_param group zoordns
	procd_set_param command /usr/bin/zoordns -zone "$zone" -pubkey "$pubkey" -resolvers "$resolvers" -listen "$listen" -country "$country" -tcp "$tcp"
	procd_append_param command -stats-file /var/run/zoordns/traffic.json -usage-file /etc/zoordns/traffic.json
	[ "$discover" = 1 ] && procd_append_param command -discover
	procd_set_param env GOMEMLIMIT=64MiB GOGC=50
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile='256 256'
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger zoordns
}
