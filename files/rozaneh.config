config client 'main'
	option enabled '0'
	option zone ''
	option encryption_key ''
	option resolver_ip_mode 'auto'
	option resolvers '1.1.1.1:53,8.8.8.8:53'
	option listen '127.0.0.1:1088'
	option discover '1'
	option country 'IR'
	option tcp 'auto'
	option resolver_transport 'auto'
	option encrypted_dns_only '0'
	option http3_fallback '1'
	option lan_killswitch '0'
	list lan_devices 'br-lan'
	option discovery_cache '1'
	option discovery_want '16'
	option discovery_concurrency '16'
	option discovery_samples '0'
	option max_clients '256'
	option idle_timeout '5m'
