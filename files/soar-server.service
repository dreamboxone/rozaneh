[Unit]
Description=Soar DNS tunnel server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=soar
Group=soar
Environment=SOAR_ALLOW_PORTS=80,443,5222,5228
EnvironmentFile=/etc/soar/server.env
ExecStart=/opt/soar/soar-server -zone ${SOAR_ZONE} -key-file /etc/soar/server.key -listen 0.0.0.0:53 -allow-ports ${SOAR_ALLOW_PORTS}
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
