#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0
# Copyright (C) 2026 dreamboxone <https://t.me/routekernel1>
START=95
STOP=10
USE_PROCD=1

start_service() {
	local enabled zone pubkey resolvers listen discover country tcp
	config_load rozaneh
	# firewall4 reapplies this guard after a firewall restart and at boot.
	if [ "$(uci -q get firewall.rozaneh_guard.path)" != /usr/libexec/rozaneh/lan-firewall.sh ]; then
		uci -q batch <<'EOF'
set firewall.rozaneh_guard=include
set firewall.rozaneh_guard.type='script'
set firewall.rozaneh_guard.path='/usr/libexec/rozaneh/lan-firewall.sh'
set firewall.rozaneh_guard.fw4_compatible='1'
commit firewall
EOF
	fi
	/usr/libexec/rozaneh/lan-firewall.sh || return 1
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	. /usr/libexec/rozaneh/dependencies.sh
	rozaneh_missing_dependencies lan
	[ -z "$missing" ] || { logger -t rozaneh "Missing packages: $missing"; return 1; }
	if rozaneh_proxy_conflict; then
		if [ "$conflict_name" = zirgozar ]; then
			logger -t rozaneh 'Zirgozar is on; Rozaneh will not start'
		else logger -t rozaneh 'Another transparent proxy is active; stop it before starting Rozaneh'; fi
		return 1
	fi
	config_get zone main zone
	config_get pubkey main encryption_key
	config_get resolvers main resolvers
	config_get listen main listen '127.0.0.1:1088'
	config_get_bool discover main discover 0
	config_get country main country 'IR'
	config_get tcp main tcp 'auto'
	[ -n "$zone" ] && [ -n "$pubkey" ] || { logger -t rozaneh 'Missing CottenDNS domain or shared key'; return 1; }
	mkdir -p /var/run/rozaneh /etc/rozaneh
	chown rozaneh:rozaneh /var/run/rozaneh /etc/rozaneh
	chmod 750 /var/run/rozaneh /etc/rozaneh
	mkdir -p /var/run/rozaneh/logs
	chown -R rozaneh:rozaneh /var/run/rozaneh/logs
	chmod 750 /var/run/rozaneh/logs
	/usr/libexec/rozaneh/cotten-config.sh || return 1
	procd_open_instance client
	procd_set_param user rozaneh
	procd_set_param group rozaneh
	procd_set_param command /usr/bin/rozaneh -config /var/run/rozaneh/client.toml -resolvers-file /var/run/rozaneh/resolvers.txt -runtime-file /var/run/rozaneh/runtime.json

	procd_set_param env GOMEMLIMIT=128MiB
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile='8192 8192'
	procd_close_instance
		procd_open_instance lan
		procd_set_param command /usr/libexec/rozaneh/lan-run.sh
		procd_set_param respawn 3600 10 3
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param term_timeout 30
		procd_close_instance
	procd_open_instance health
	procd_set_param user rozaneh
	procd_set_param group rozaneh
	procd_set_param command /usr/libexec/rozaneh/health-run.sh
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 20
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
 [ ! -x /usr/libexec/rozaneh/read-logs ] || ROZANEH_LOG_ACTIVE=0 /usr/libexec/rozaneh/read-logs >/dev/null
 # Keep diagnostic evidence when the service stops; active captures live in RAM.
 mkdir -p /etc/rozaneh
 for diagnostic in runtime.json paths.json traffic.json; do
  if [ -f "/var/run/rozaneh/$diagnostic" ]; then
   cat "/var/run/rozaneh/$diagnostic" > "/etc/rozaneh/last-$diagnostic"
   chmod 600 "/etc/rozaneh/last-$diagnostic"
  fi
 done
 [ ! -x /usr/libexec/rozaneh/lan-cleanup.sh ] || /usr/libexec/rozaneh/lan-cleanup.sh
 [ ! -x /usr/libexec/rozaneh/lan-firewall.sh ] || /usr/libexec/rozaneh/lan-firewall.sh
}

service_triggers() {
	procd_add_reload_trigger rozaneh
	local wan wan6
	. /lib/functions/network.sh
	network_find_wan wan || wan=wan
	network_find_wan6 wan6 || wan6=wan6
	procd_add_interface_trigger 'interface.*' "$wan" /etc/init.d/rozaneh restart
	[ "$wan6" = "$wan" ] || procd_add_interface_trigger 'interface.*' "$wan6" /etc/init.d/rozaneh restart
}
